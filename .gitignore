# 🚀 Hybrid Platform - .gitignore

# ===== Java =====
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ===== IDE и редакторы =====
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# VS Code
.vscode/
*.code-workspace

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Vim
*.swp
*.swo
*~

# ===== Docker =====
# Docker образы
*.tar
*.tar.gz
*.tar.bz2

# Docker Compose
docker-compose.override.yml

# ===== Kubernetes =====
# kubeconfig файлы
kubeconfig.yaml
kubeconfig.yml
*.kubeconfig

# kind кластеры
kind-*

# ===== Логи и временные файлы =====
*.log
*.log.*
logs/
tmp/
temp/
*.tmp
*.temp

# ===== Системные файлы =====
# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.tmp
*.temp
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# ===== Безопасность =====
# Секреты и ключи
*.key
*.pem
*.crt
*.p12
*.pfx
*.jks
*.keystore
secrets/
.env
.env.local
.env.development
.env.test
.env.production

# Конфигурационные файлы с секретами
mycrypt.json
authorized_key.json
application-local.yml
application-dev.yml
application-prod.yml

# ===== Базы данных =====
*.db
*.sqlite
*.sqlite3
dump.rdb
*.rdb

# ===== Мониторинг и метрики =====
# Prometheus
prometheus-data/
tsdb/

# Grafana
grafana-data/
grafana.db

# ===== Тестовые файлы =====
# Тестовые образы и конфигурации
test-*.yaml
test-*.yml
simple-*.yaml
simple-*.yml

# ===== Сборка и деплой =====
# Локальные скрипты деплоя
deploy-*.sh
create-*.sh
test-*.sh

# Временные файлы деплоя
*.deployment
*.deployment.*
deployment-*.md

# ===== Документация =====
# Временные файлы документации
*.md~
*.md.bak
*.md.tmp

# ===== Специфичные для проекта =====
# Redis дампы
redis/dump.rdb
HTTPService/redis/dump.rdb

# Grafana база данных
HTTPService/grafana/grafana.db
HTTPService/grafana/plugins/

# Prometheus конфигурация
HTTPService/prometheus/prometheus.yml

# Бэкапы конфигураций
**/application.properties.bak
**/application.yml.bak
**/*.conf.bak

# ===== Исключения =====
# Важные файлы, которые НЕ должны игнорироваться
!README.md
!KUBERNETES-SETUP.md
!GITHUB-SETUP.md
!.github/workflows/deploy.yml
!kind-config.yaml
!Helm/**/*.yaml
!Helm/**/*.yml
!Helm/**/*.proto
!Helm/**/*.json
!Helm/**/*.md
!src/**/*.java
!src/**/*.proto
!src/**/*.xml
!src/**/*.yml
!src/**/*.yaml
!src/**/*.properties
!src/**/*.conf
!pom.xml
!Dockerfile*

# ===== Комментарии =====
# Этот файл игнорирует:
# - Временные файлы и логи
# - Секреты и ключи
# - Собранные артефакты
# - IDE файлы
# - Системные файлы
# - Тестовые конфигурации
# - Локальные скрипты деплоя
#
# НЕ игнорирует:
# - Исходный код
# - Helm чарты
# - Конфигурации
# - Документацию
# - GitHub Actions
