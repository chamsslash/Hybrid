        </dependency>
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-client-spring-boot-starter</artifactId>
            <version>2.14.0.RELEASE</version> <!-- или новее -->
        </dependency>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>3.7.1</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>com.salesforce.servicelibs</groupId>
            <artifactId>reactor-grpc-stub</artifactId>
            <version>1.2.4</version>
        </dependency>
        <!-- Reactive gRPC -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-client-spring-boot-autoconfigure</artifactId>
            <version>2.15.0.RELEASE</version>
        </dependency>

        <!-- Распределённый трейсинг (beads izv).

             Мостом выбран Brave, а не OpenTelemetry, из-за матрицы версий:
             Spring Boot 3.1.3 управляет opentelemetry-bom 1.28, а свежие
             micrometer-tracing-bridge-otel требуют 1.32+. Brave, brave-bom и
             zipkin-reporter Boot держит согласованным набором, поэтому здесь ни
             одна версия не указана явно — все приходят из parent'а. Подробности:
             docs/observability.md, §13.2.

             brave-instrumentation-grpc даёт готовые Client/ServerInterceptor для
             переноса trace-контекста через gRPC-метаданные. Свои интерсепторы
             писать не пришлось: собственная реализация обязана правильно
             открывать и закрывать scope на асинхронных вызовах, а ошибка там
             ведёт к утечке контекста между запросами. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>io.zipkin.reporter2</groupId>
            <artifactId>zipkin-reporter-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>io.zipkin.brave</groupId>
            <artifactId>brave-instrumentation-grpc</artifactId>
        </dependency>

    </dependencies>




</project>
