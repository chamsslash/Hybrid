            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers: MinIO integration тест ImageStorageService (beads se2) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
