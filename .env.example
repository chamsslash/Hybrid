# Local dev secrets for ./deploy-kind.sh
#
# Copy this file to .env (gitignored) and fill in real values, or leave a
# variable unset/commented to fall back to the throwaway kind-only default
# baked into deploy-kind.sh. NEVER commit the real .env file.
#
#   cp .env.example .env

# Postgres application password
# -> secrets.dbPassword (DB_PASSWORD / SPRING_DATASOURCE_PASSWORD / PGPASSWORD / POSTGRES_PASSWORD)
DB_PASSWORD=changeme-postgres

# Grafana admin password
# -> secrets.grafanaAdminPassword (GF_SECURITY_ADMIN_PASSWORD)
GRAFANA_ADMIN_PASSWORD=changeme-grafana

# Google OAuth client (authservice)
# -> authservice.google.clientId (GOOGLE_CLIENT_ID) — not a secret, but kept
#    here so client id/secret stay together.
GOOGLE_CLIENT_ID=changeme-google-client-id
# -> secrets.googleClientSecret (GOOGLE_CLIENT_SECRET)
GOOGLE_CLIENT_SECRET=changeme-google-client-secret

# Refresh-token signing secret (httpservice). MUST be valid Base64 — it's
# decoded into raw HMAC key bytes (see TokensResolver.refreshKey()), a plain
# string here breaks token issuance with "Illegal base64 character".
# Generate one with: openssl rand -base64 64
# -> secrets.refreshSecret (REFRESH_SECRET)
REFRESH_SECRET=Y2hhbmdlbWUtcmVmcmVzaC1zZWNyZXQ=

# MinIO server root identity/credential
# -> secrets.minioRootUser (MINIO_ROOT_USER)
MINIO_ROOT_USER=changeme-minio-root-user
# -> secrets.minioRootPassword (MINIO_ROOT_PASSWORD)
MINIO_ROOT_PASSWORD=changeme-minio-root-password

# MinIO application access key/secret (httpservice S3 client)
# -> secrets.minioAccessKey (MINIO_ACCESS_KEY)
MINIO_ACCESS_KEY=changeme-minio-access-key
# -> secrets.minioSecretKey (MINIO_SECRET_KEY)
MINIO_SECRET_KEY=changeme-minio-secret-key

# NOTE: JWT and Yandex signing keys (secrets.jwtPrivateKeyPem /
# secrets.yandexPrivateKeyPem) are NOT configured here — deploy-kind.sh mints
# fresh, disposable RSA keypairs on every run and injects them via
# --set-file. There is nothing to put in .env for those.
